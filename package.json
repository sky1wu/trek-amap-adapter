{
  "name": "trek-amap-adapter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Independent AMap Places and routing adapter with TREK plugins",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "smoke:routes": "node --env-file-if-exists=.env --import tsx scripts/smoke-routes.ts",
    "plugins:build": "node --import tsx scripts/build-plugins.ts"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "trek-plugin-sdk": "1.7.0",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
