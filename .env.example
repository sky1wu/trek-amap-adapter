# AMap Web Service key. Never commit your real .env file.
AMAP_KEY=
PORT=8080
LOG_LEVEL=info
HOST=0.0.0.0
AMAP_TIMEOUT_MS=8000
AMAP_MAX_RESPONSE_BYTES=2000000
AMAP_MAX_CONCURRENT=20
CACHE_MAX_ENTRIES=1000
# Enable only if your AMap key has paid multilingual POI permission.
AMAP_ENGLISH_ENABLED=false
# Optional local authentication (16+ characters); use the same value in TREK's PLACES_API_KEY.
# ADAPTER_TOKEN=
# Phase 2 route plugins call AMap directly; configure their encrypted amapKey setting in TREK.
# They can use the same AMAP_KEY. Existing Places deployment can remain at v0.1.0.
# Phase 2 from source: ADAPTER_IMAGE=trek-amap-adapter:phase2-local (use Compose --build).
# For a published Phase 2 build, pin ADAPTER_IMAGE to ghcr.io/sky1wu/trek-amap-adapter:sha-<full-commit>.
# Compose options:
TREK_IMAGE=mauriceboe/trek:4.2.1
TREK_PORT=3000
# Keep a stable encryption key for TREK, or let TREK persist one in its data volume.
ENCRYPTION_KEY=
